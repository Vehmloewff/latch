{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "noEmit": true,
        "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "declaration": false
  },
  "include": ["*.ts", "test/**/*.ts"]
}
